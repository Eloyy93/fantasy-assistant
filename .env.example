# Fuente de datos activa: biwenger | laligafantasy
FANTASY_SOURCE=biwenger

# Base de datos
DATABASE_URL=sqlite:///fantasy_assistant.db

# Telegram
TELEGRAM_BOT_TOKEN=

# Biwenger (opcional, solo necesario para login/plantilla de usuario)
BIWENGER_EMAIL=
BIWENGER_PASSWORD=

# LaLiga Fantasy (fase 2, OAuth2 B2C)
LALIGAFANTASY_CLIENT_ID=
LALIGAFANTASY_CLIENT_SECRET=

# Predictor de precio
PRICE_PREDICTOR_UP_THRESHOLD=1.15
PRICE_PREDICTOR_DOWN_THRESHOLD=0.85
